# Server only. Never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# BigQuery evidence layer: use local until bq:setup and bq:verify succeed.
DATA_BACKEND=local
GOOGLE_CLOUD_PROJECT=
BIGQUERY_DATASET=lendwise_demo
BIGQUERY_LOCATION=US
# Authenticate via gcloud auth application-default login, not an API key.
