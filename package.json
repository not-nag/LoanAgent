{
  "name": "lendwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "bq:prepare": "tsx --env-file=.env.local scripts/bigquery/setup.ts --prepare-only",
    "bq:setup": "tsx --env-file=.env.local scripts/bigquery/setup.ts",
    "bq:verify": "tsx --env-file=.env.local scripts/bigquery/verify.ts",
    "bq:index": "tsx --env-file=.env.local scripts/bigquery/index-documents.ts",
    "bq:verify-rag": "tsx --env-file=.env.local scripts/bigquery/verify-rag.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@google-cloud/bigquery": "^9.6.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.0",
    "unpdf": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
